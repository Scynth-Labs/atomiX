    given-names: Shubhendra
    email: shubhendragautam1513@gmail.com
repository-code: "https://github.com/ShubhendraGautam/atomiX"
license: MIT
date-released: "2026-08-10"
keywords:
  - RISC-V
  - FPGA
  - partial reconfiguration
  - reconfigurable computing
  - coarse-grained reconfigurable array
  - hardware/software co-design
  - evolvable hardware
