{
  "schema": "org.atomix.verification-suites.v1",
  "stages": {
    "runtime-payload": {
      "label": "Native runtime payload reuse, baked parity, and interactive continuity",
      "command": [
        "make",
        "-C",
        "sim/soc",
        "check-runtime-payload"
      ],
      "profiles": [
        "configs/sim-role-loopback.json",
        "configs/sim-delayed.json",
        "configs/kernel-default.json"
      ],
      "timeout_seconds": 1800,
      "requires": [
        "make",
        "python3",
        "verilator"
      ]
    },
    "doc-examples": {
      "label": "every documentation example boots the machine it describes, and the formal, cosim, and rollback evidence renders faithfully from its records",
      "command": [
        "make",
        "example-replay",
        "evidence-views"
      ],
      "profiles": [
        "configs/sim-bram.json",
        "configs/sim-role-loopback.json"
      ],
      "timeout_seconds": 1800,
      "requires": [
        "make",
        "verilator",
        "python3"
      ]
    },
    "axsim-directed": {
      "label": "Golden ISS smoke and trap tests",
      "command": [
        "make",
        "-C",
        "sim/axsim",
        "test"
      ],
      "timeout_seconds": 300,
      "requires": [
        "make"
      ]
    },
    "system-profiles": {
      "label": "Resolve every supplied system profile",
      "command": [
        "make",
        "config-check-all"
      ],
      "timeout_seconds": 300,
      "requires": [
        "make",
        "python3"
      ]
    },
    "kernel-profiles": {
      "label": "Resolve every supplied kernel profile",
      "command": [
        "make",
        "-C",
        "sw/kernel",
        "kernel-config-check-all"
      ],
      "timeout_seconds": 300,
      "requires": [
        "make",
        "python3"
      ]
    },
    "kernel-build-identity": {
      "label": "a reused kernel build tree holds the configuration it claims, and each personality boots as itself",
      "command": [
        "make",
        "-C",
        "sw/kernel",
        "check-build-identity"
      ],
      "profiles": [
        "configs/kernel-default.json",
        "configs/kernel-slow-memory.json",
        "configs/kernel-small-caps.json",
        "configs/kernel-primer-monitor.json",
        "configs/sim-bram.json"
      ],
      "timeout_seconds": 1800,
      "requires": [
        "make",
        "python3"
      ]
    },
    "research-contracts": {
      "label": "Personality, comparison, experiment, ECP5 frame, and partial-image delta research contracts",
      "command": [
        "make",
        "comparison-check",
        "experiment-check",
        "ecp5-frame-check",
        "pr-gate-check"
      ],
      "timeout_seconds": 300,
      "requires": [
        "make",
        "python3"
      ]
    },
    "experiment-adapters": {
      "label": "Execution adapters, bounded sweeps, and the comparison report: their refusals, and one plan run end to end",
      "command": [
        "make",
        "adapter-check",
        "experiment-sweep-check",
        "experiment-run",
        "experiment-report-check"
      ],
      "timeout_seconds": 900,
      "requires": [
        "make",
        "python3",
        "cc",
        "verilator"
      ]
    },
    "l3-search": {
      "label": "All-mode morph search, mutation, canary, and rollback",
      "command": [
        "make",
        "l3-check"
      ],
      "timeout_seconds": 900,
      "requires": [
        "make",
        "python3",
        "verilator"
      ]
    },
    "live-rtl": {
      "label": "Immutable Live FPGA monitor and isolation RTL",
      "command": [
        "make",
        "live-check"
      ],
      "timeout_seconds": 900,
      "requires": [
        "make",
        "verilator"
      ]
    },
    "candidate-registry": {
      "label": "Content-addressed evolution candidates and record chains",
      "command": [
        "make",
        "registry-check"
      ],
      "timeout_seconds": 300,
      "requires": [
        "make",
        "python3"
      ]
    },
    "live-closed-loop": {
      "label": "Live FPGA policy, RV32 shadow evaluation, and rollback",
      "command": [
        "make",
        "live-sim-check"
      ],
      "timeout_seconds": 900,
      "requires": [
        "make",
        "python3"
      ]
    },
    "cosim-directed": {
      "label": "Directed ISS/RTL lock-step cosimulation",
      "command": [
        "make",
        "-C",
        "sim/cosim",
        "test"
      ],
      "timeout_seconds": 1200,
      "requires": [
        "make",
        "verilator"
      ]
    },
    "rtl-units": {
      "label": "All RTL units, core-directed tests, and parameter suites",
      "command": [
        "make",
        "-C",
        "sim/unit",
        "test"
      ],
      "timeout_seconds": 7200,
      "requires": [
        "make",
        "verilator"
      ]
    },
    "component-composition": {
      "label": "Component composition across supplied profiles",
      "command": [
        "make",
        "component-test"
      ],
      "timeout_seconds": 5400,
      "requires": [
        "make",
        "verilator",
        "python3"
      ]
    },
    "baremetal-peripherals": {
      "label": "Bare-metal SPI and SD paths on RTL",
      "command": [
        "make",
        "-C",
        "sw/baremetal",
        "check-spi",
        "check-sd"
      ],
      "timeout_seconds": 2400,
      "requires": [
        "make",
        "verilator"
      ]
    },
    "baremetal-role": {
      "label": "Bare-metal role window and interrupt path on RTL",
      "command": [
        "make",
        "-C",
        "sw/baremetal",
        "check-role",
        "check-role-irq"
      ],
      "timeout_seconds": 2400,
      "requires": [
        "make",
        "verilator"
      ]
    },
    "baremetal-games": {
      "label": "Shipped games replayed on RTL: exact final state, no missed frame, and the same result when uploaded to blank RAM rather than baked into the image",
      "command": [
        "make",
        "-C",
        "sw/baremetal",
        "check-game2048",
        "check-snake",
        "check-snake-loader"
      ],
      "timeout_seconds": 2400,
      "requires": [
        "make",
        "verilator"
      ]
    },
    "baremetal-accelerators": {
      "label": "GPU, TPU, scalable GPU, and performance workloads on RTL",
      "command": [
        "make",
        "-C",
        "sw/baremetal",
        "check-tpu",
        "check-gpu",
        "check-gpu-perf",
        "check-gpu1",
        "check-gpu-tpu",
        "check-cpu-perf"
      ],
      "timeout_seconds": 10800,
      "requires": [
        "make",
        "verilator"
      ]
    },
    "architecture-suites": {
      "label": "Minimal-host and dual-issue composed architecture suites",
      "command": [
        "make",
        "-C",
        "sw/baremetal",
        "check-suite-minimal",
        "check-suite-ax2"
      ],
      "timeout_seconds": 10800,
      "requires": [
        "make",
        "verilator"
      ]
    },
    "kernel-shell": {
      "label": "aXos shell, role driver, interrupt, and host-link",
      "command": [
        "make",
        "-C",
        "sw/kernel",
        "check-shell",
        "check-role-driver",
        "check-role-irq",
        "check-hostlink",
        "check-hostlink-stream"
      ],
      "profiles": [
        "configs/kernel-default.json",
        "configs/sim-role-loopback.json"
      ],
      "timeout_seconds": 5400,
      "requires": [
        "make",
        "verilator",
        "python3"
      ]
    },
    "kernel-runtime-switch": {
      "label": "Primer host-managed runtime switching",
      "command": [
        "make",
        "-C",
        "sw/kernel",
        "check-primer-runtime"
      ],
      "profiles": [
        "configs/sim-primer-runtime-gpu.json"
      ],
      "timeout_seconds": 5400,
      "requires": [
        "make",
        "verilator",
        "python3"
      ]
    },
    "kernel-primer-ci": {
      "label": "Primer 32 KiB boot and UART kernel upload",
      "command": [
        "make",
        "-C",
        "sw/kernel",
        "check-primer",
        "check-uartboot"
      ],
      "profiles": [
        "configs/kernel-primer-monitor.json",
        "configs/sim-primer-runtime-gpu.json"
      ],
      "timeout_seconds": 3600,
      "requires": [
        "make",
        "verilator",
        "python3"
      ]
    },
    "kernel-storage-mutation": {
      "label": "aXos filesystem writes and SD boot, including exec at the default scheduling quantum",
      "command": [
        "make",
        "-C",
        "sw/kernel",
        "check-storage-write",
        "check-sdboot",
        "check-sdboot-exec"
      ],
      "profiles": [
        "configs/sim-sdram.json",
        "configs/kernel-slow-memory.json",
        "configs/kernel-default.json"
      ],
      "timeout_seconds": 7200,
      "requires": [
        "make",
        "verilator",
        "python3"
      ]
    },
    "kernel-storage-ci": {
      "label": "aXos on external memory with caches",
      "command": [
        "make",
        "-C",
        "sw/kernel",
        "check-storage"
      ],
      "timeout_seconds": 3600,
      "requires": [
        "make",
        "verilator",
        "python3"
      ]
    },
    "kernel-hardening": {
      "label": "external memory, W^X loader rejection, and the adversarial ABI program at default and small capacities",
      "command": [
        "make",
        "-C",
        "sw/kernel",
        "check-memory",
        "check-loader-wx",
        "check-abi-torture",
        "check-abi-torture-small"
      ],
      "profiles": [
        "configs/kernel-default.json",
        "configs/kernel-small-caps.json"
      ],
      "timeout_seconds": 3600,
      "requires": [
        "make",
        "verilator",
        "python3"
      ]
    },
    "randomized-fuzz": {
      "label": "Deterministic randomized M-mode instruction campaign",
      "command": [
        "make",
        "-C",
        "sim/testgen",
        "fuzz"
      ],
      "timeout_seconds": 7200,
      "requires": [
        "make",
        "verilator",
        "python3"
      ]
    },
    "randomized-paging": {
      "label": "Deterministic randomized Sv32 paging campaign",
      "command": [
        "make",
        "-C",
        "sim/testgen",
        "paging"
      ],
      "timeout_seconds": 7200,
      "requires": [
        "make",
        "verilator",
        "python3"
      ]
    },
    "isa-build": {
      "label": "Build official RV32UI, RV32MI, and RV32UM suites",
      "command": [
        "./tests/build-isa.sh",
        "rv32ui",
        "rv32mi",
        "rv32um"
      ],
      "timeout_seconds": 2400,
      "requires": [
        "make"
      ]
    },
    "isa-iss": {
      "label": "Official ISA suites against the golden ISS",
      "command": [
        "./tests/run-riscv-tests.sh",
        "rv32ui",
        "rv32mi",
        "rv32um"
      ],
      "timeout_seconds": 5400,
      "requires": [
        "make"
      ]
    },
    "isa-cosim-build": {
      "label": "Build the RTL lock-step ISA harness",
      "command": [
        "make",
        "-C",
        "sim/cosim",
        "axcosim"
      ],
      "timeout_seconds": 2400,
      "requires": [
        "make",
        "verilator"
      ]
    },
    "isa-cosim": {
      "label": "Official ISA suites against RTL in lock-step",
      "command": [
        "./tests/run-riscv-tests.sh",
        "rv32ui",
        "rv32mi",
        "rv32um"
      ],
      "timeout_seconds": 10800,
      "requires": [
        "make",
        "verilator"
      ],
      "env": {
        "SIM": "{root}/sim/cosim/obj_dir/axcosim"
      }
    },
    "three-platform-baremetal": {
      "label": "Bare-metal agreement across ISS, QEMU, and RTL",
      "command": [
        "make",
        "-C",
        "sw/baremetal",
        "check-hello",
        "check-timer",
        "check-preempt",
        "check-fencei"
      ],
      "timeout_seconds": 10800,
      "requires": [
        "make",
        "verilator",
        "qemu-system-riscv32"
      ]
    },
    "three-platform-kernel": {
      "label": "aXos scheduler profiles across ISS, QEMU, and RTL",
      "command": [
        "make",
        "-C",
        "sw/kernel",
        "kernel-component-test"
      ],
      "timeout_seconds": 10800,
      "requires": [
        "make",
        "verilator",
        "qemu-system-riscv32"
      ]
    },
    "diagrams": {
      "label": "Every mermaid diagram is structurally well formed",
      "command": [
        "make",
        "diagram-check"
      ],
      "timeout_seconds": 120,
      "requires": []
    },
    "brand-assets": {
      "label": "Derived brand assets match the master lockup",
      "command": [
        "make",
        "brand-check"
      ],
      "timeout_seconds": 120,
      "requires": []
    },
    "static-analysis": {
      "label": "RTL lint, C path analysis, Python, and shell",
      "command": [
        "make",
        "static-analysis"
      ],
      "timeout_seconds": 900,
      "requires": [
        "verilator",
        "riscv64-unknown-elf-gcc"
      ]
    },
    "fuzz-loader": {
      "label": "Malformed ELF images against the program loader",
      "command": [
        "make",
        "fuzz-loader"
      ],
      "timeout_seconds": 600,
      "requires": [
        "clang"
      ]
    },
    "toolchain-llvm": {
      "label": "The kernel builds and runs under clang/lld",
      "command": [
        "make",
        "toolchain-llvm"
      ],
      "timeout_seconds": 900,
      "requires": [
        "clang",
        "ld.lld",
        "riscv64-unknown-elf-gcc"
      ]
    },
    "requirements": {
      "label": "Host and docs against tools/requirements.json",
      "command": [
        "make",
        "requirements-check"
      ],
      "timeout_seconds": 120,
      "requires": [
        "make",
        "python3"
      ]
    },
    "verification-contract": {
      "label": "the suite manifest, the runner's own failure modes, and the inventory of advertised commands",
      "command": [
        "make",
        "verification-check"
      ],
      "timeout_seconds": 600,
      "requires": [
        "make",
        "python3"
      ]
    }
  },
  "suites": {
    "smoke": [
      "requirements",
      "verification-contract",
      "system-profiles",
      "kernel-profiles",
      "kernel-build-identity",
      "research-contracts",
      "l3-search",
      "axsim-directed",
      "live-rtl",
      "candidate-registry",
      "live-closed-loop"
    ],
    "ci-quick": [
      "requirements",
      "verification-contract",
      "axsim-directed",
      "system-profiles",
      "kernel-profiles",
      "kernel-build-identity",
      "candidate-registry",
      "cosim-directed",
      "diagrams",
      "brand-assets"
    ],
    "analysis": [
      "static-analysis",
      "toolchain-llvm",
      "fuzz-loader"
    ],
    "ci-unit": [
      "rtl-units"
    ],
    "ci-integration": [
      "experiment-adapters",
      "runtime-payload",
      "doc-examples",
      "component-composition",
      "baremetal-peripherals",
      "baremetal-role",
      "baremetal-games",
      "kernel-shell",
      "kernel-primer-ci",
      "kernel-storage-ci"
    ],
    "nightly-integrated": [
      "experiment-adapters",
      "runtime-payload",
      "doc-examples",
      "requirements",
      "verification-contract",
      "system-profiles",
      "kernel-profiles",
      "kernel-build-identity",
      "research-contracts",
      "l3-search",
      "axsim-directed",
      "cosim-directed",
      "live-rtl",
      "candidate-registry",
      "live-closed-loop",
      "rtl-units",
      "component-composition",
      "baremetal-peripherals",
      "baremetal-role",
      "baremetal-games",
      "baremetal-accelerators",
      "architecture-suites",
      "kernel-shell",
      "kernel-primer-ci",
      "kernel-runtime-switch",
      "kernel-storage-ci",
      "kernel-hardening",
      "kernel-storage-mutation",
      "diagrams",
      "brand-assets"
    ],
    "randomized": [
      "randomized-fuzz",
      "randomized-paging"
    ],
    "isa": [
      "isa-build",
      "axsim-directed",
      "isa-iss",
      "isa-cosim-build",
      "isa-cosim"
    ],
    "three-platform": [
      "three-platform-baremetal",
      "three-platform-kernel"
    ]
  }
}
