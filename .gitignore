# build outputs
*.o
*.a
*.elf
*.bin
*.hex
# The blank RAM image is a source input, not a build product: it is a fixed
# one-word image meaning "memory starts empty", and the UART-loader checks, the
# FPGA flow, and axhost all reference it by path with nothing generating it.
# Keep the exception adjacent to the broad rule that would otherwise hide it.
!sw/bootrom/blank.hex
*.map
obj_dir*/
build/
# isolated FPGA synth trees from `make -C rtl/fpga ... BUILD=build-<tag>`
build-*/

# aXsim binary
sim/axsim/axsim

# simulation artifacts
*.vcd
*.fst
*.fst.hier
trace.log
__pycache__/

# FPGA flow outputs
*.json
# Component manifests and supplied build profiles are source inputs, not
# generated FPGA JSON. Keep these exceptions adjacent to the broad rule so
# new profiles are visible to Git by default.
!components/**/component.json
!configs/*.json
# Live FPGA records are checked research inputs/evidence, not synthesis output.
!research/live-fpga/*.json
!research/live-fpga/**/*.json
# Verification manifests are source inputs, not generated tool output.
!tests/verification-suites.json
*.asc
*.bit
*.svf
# Lab images may be retained locally for a board session, but generated FPGA
# artifacts never belong in Git. Release identity is recorded as hashes in the
# hardware achievement/manifest documentation instead.
artifacts/local/

# Browser bundle. The page sources in sim/web/public/ are tracked; the compiled
# machine and the payload staged beside them are build products of
# `make -C sim/web build` (payload.hex is already covered by *.hex above).
sim/web/public/axsoc.js
sim/web/public/axsoc.wasm
sim/web/public/.bundle-tag

# editor noise
*.swp
.vscode/
# Formal-generated jobs, solver databases, and counterexample traces.
formal/build/
