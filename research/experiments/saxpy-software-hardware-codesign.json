    {"id": "org.atomix.metric.simulator-host-elapsed-median", "unit": "org.atomix.unit.nanosecond", "direction": "org.atomix.context-only", "domain": "org.atomix.domain.simulator-host-elapsed", "applicability": {"org.atomix.native-host": "org.atomix.inapplicable", "org.atomix.rtl-simulator": "org.atomix.optional"}}
