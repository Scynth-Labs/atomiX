    {"id": "org.atomix.metric.total-cycles", "unit": "org.atomix.unit.cycle", "direction": "org.atomix.lower-is-better", "domain": "org.atomix.domain.model-cycles", "applicability": {"org.atomix.native-host": "org.atomix.inapplicable", "org.atomix.rtl-simulator": "org.atomix.required"}},
