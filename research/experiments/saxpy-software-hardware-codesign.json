  "policy": {"correctness": "org.atomix.hard-gate", "missing_measurement": "org.atomix.unavailable-not-zero", "ranking": "org.atomix.pareto-no-composite", "cross_domain_ranking": "org.atomix.forbidden", "resource_claims": "org.atomix.require-matched-evidence"},
