    {"id": "org.atomix.candidate.codesign-simt-multiply", "implementation": "org.atomix.implementation.saxpy-simt-multiply", "target": "org.atomix.target.role-gpu-compute-sim", "parameters": {}, "work": {"unit": "org.atomix.output-element", "count": 17}, "sweep": {"target_parameters": {"lanes": [1, 4]}}},
    {"id": "org.atomix.candidate.codesign-simt-add-chain", "implementation": "org.atomix.implementation.saxpy-simt-add-chain", "target": "org.atomix.target.role-gpu-compute-sim", "parameters": {}, "work": {"unit": "org.atomix.output-element", "count": 17}, "sweep": {"target_parameters": {"lanes": [1, 4]}}}
  ],
  "metrics": [
    {"id": "org.atomix.metric.work-items", "unit": "org.atomix.unit.item", "direction": "org.atomix.context-only", "domain": "org.atomix.domain.context", "applicability": {"org.atomix.native-host": "org.atomix.required", "org.atomix.rtl-simulator": "org.atomix.required"}},
