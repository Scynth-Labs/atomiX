{
  "schema": {"id": "org.atomix.workload", "major": 1, "minor": 0},
  "kind": "workload",
  "id": "org.atomix.workload.saxpy-i32",
  "revision": 2,
  "summary": "SAXPY revision 2: revision 1 semantics with wrap, single-element, and SIMT tail cases added",
  "operation": "org.atomix.workload.saxpy-i32",
  "parameters": {"items": 50, "a": 3},
  "buffers": [
    {
      "name": "x",
      "direction": "org.atomix.input",
      "element": {"format": "org.atomix.integer", "properties": {"bits": 32, "signed": true, "overflow": "org.atomix.twos-complement-wrap"}},
      "shape": ["items"],
      "layout": "org.atomix.row-major"
    },
    {
      "name": "y",
      "direction": "org.atomix.input",
      "element": {"format": "org.atomix.integer", "properties": {"bits": 32, "signed": true, "overflow": "org.atomix.twos-complement-wrap"}},
      "shape": ["items"],
      "layout": "org.atomix.row-major"
    },
    {
      "name": "out",
      "direction": "org.atomix.output",
      "element": {"format": "org.atomix.integer", "properties": {"bits": 32, "signed": true, "overflow": "org.atomix.twos-complement-wrap"}},
      "shape": ["items"],
      "layout": "org.atomix.row-major"
    }
  ],
  "oracle": {"kind": "org.atomix.builtin-exact", "operation": "org.atomix.workload.saxpy-i32", "properties": {}},
  "cases": [
    {
      "name": "signed-and-tail",
      "parameters": {"items": 5, "a": 3},
      "inputs": {"x": [1, -2, 3, 4, 5], "y": [10, 20, -30, 40, 50]},
      "expected": {"out": [13, 14, -21, 52, 65]}
    },
    {
      "name": "int32-wrap",
      "parameters": {"items": 4, "a": 3},
      "inputs": {"x": [2147483647, -2147483648, 1073741824, -1], "y": [1, -1, 1073741824, 2147483647]},
      "expected": {"out": [2147483646, 2147483647, 0, 2147483644]}
    },
    {
      "name": "single-element",
      "parameters": {"items": 1, "a": 3},
      "inputs": {"x": [-1], "y": [2147483647]},
      "expected": {"out": [2147483644]}
    },
    {
      "name": "simt-lane-tail",
      "parameters": {"items": 7, "a": 3},
      "inputs": {"x": [1, 2, 3, 4, 5, 6, 7], "y": [-1, -2, -3, -4, -5, -6, -7]},
      "expected": {"out": [2, 4, 6, 8, 10, 12, 14]}
    }
  ],
  "metrics": ["org.atomix.metric.execute-cycles", "org.atomix.metric.host-elapsed-median"],
  "extensions": {}
