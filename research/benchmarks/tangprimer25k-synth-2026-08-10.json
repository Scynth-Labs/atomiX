  "regression_bisect_2026_08_10": {
    "ax2": "Left as an explicit known failure at the user's direction: 25,569 LUT4 (110%) in its original configuration. It overflows rather than failing to place, and making it fit required dropping branch prediction, which changes what the profile measures.",
    "fix": "soc.reference exposes live_monitor (define AX_LIVE_MONITOR); a LIVE_MON localparam now folds out the instance, the register decode, the command validation and the read muxes together.",
    "method": "rebuild the tpu profile at successive commits in a worktree",
    "result": {
      "bsram": 48,
      "design_changed": false,
      "fmax_mhz": 31.74,
      "lut4": 18134,
      "mult12x12": 24,
      "note": "Full 8x8 tile and all 24 DSPs retained; no RTL change to the role.",
      "percent": 78,
      "place_route_status": "PASS"
    },
    "root_cause": "77553a2 added the axlivemon counters *and* their register decode inside axroleiso. Together they cost about 2,100 LUT4 in every profile, which pushed role.tpu-lite past the point where nextpnr could legalise a placement.",
    "symptom": "role.tpu-lite profile stopped placing; physically verified 2026-07-29",
